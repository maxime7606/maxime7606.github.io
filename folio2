<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Maxime Leroy — Portfolio BTS SIO SLAM</title>
<meta name="description" content="Portfolio de Maxime Leroy, étudiant en BTS SIO option SLAM.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<script>
  (function () {
    var saved = localStorage.getItem("theme");
    document.documentElement.setAttribute("data-theme", saved || "dark");
  })();
</script>
<style>
  :root {
    --bg: #f3f5f8;
    --panel: #ffffff;
    --bar: #e4e9f0;
    --text: #17212f;
    --muted: #55637a;
    --accent: #0a6c8a;
    --green: #1a7f37;
    --amber: #9a5b00;
    --border: #d3dae5;
    --grid: rgba(10, 108, 138, 0.06);
    color-scheme: light;
  }
  [data-theme="dark"] {
    --bg: #0a111d;
    --panel: #101a2a;
    --bar: #16233a;
    --text: #d8e3f2;
    --muted: #8a9bb5;
    --accent: #5ad1e6;
    --green: #7ee787;
    --amber: #f2b84b;
    --border: #213250;
    --grid: rgba(90, 209, 230, 0.05);
    color-scheme: dark;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    font-family: "Inter", system-ui, sans-serif;
    background-color: var(--bg);
    background-image:
      linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 32px 32px;
    color: var(--text);
    line-height: 1.6;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  a { color: inherit; }
  section { scroll-margin-top: 84px; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .mono { font-family: "JetBrains Mono", ui-monospace, Consolas, monospace; }
  .wrap { max-width: 920px; margin: 0 auto; padding: 0 1.5rem; }

  /* Header */
  header {
    position: sticky; top: 0; z-index: 20;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }
  .nav {
    display: flex; align-items: center; justify-content: space-between;
    padding: 0.9rem 1.5rem; max-width: 920px; margin: 0 auto;
    font-family: "JetBrains Mono", ui-monospace, Consolas, monospace;
  }
  .logo { font-weight: 700; font-size: 0.92rem; text-decoration: none; }
  .logo .u { color: var(--green); }
  .logo .h { color: var(--accent); }
  .nav-links { display: flex; gap: 1.5rem; list-style: none; margin: 0; padding: 0; }
  .nav-links a { text-decoration: none; font-size: 0.85rem; color: var(--muted); }
  .nav-links a:hover { color: var(--accent); }
  .nav-right { display: flex; align-items: center; gap: 0.75rem; }
  .theme-toggle, .menu-btn {
    border: 1px solid var(--border); background: var(--panel); color: var(--text);
    width: 34px; height: 34px; border-radius: 6px; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
  }
  .theme-toggle svg { width: 16px; height: 16px; }
  .theme-toggle .icon-moon { display: none; }
  [data-theme="dark"] .theme-toggle .icon-sun { display: none; }
  [data-theme="dark"] .theme-toggle .icon-moon { display: block; }
  .menu-btn { display: none; }

  @media (max-width: 700px) {
    .nav-links {
      position: absolute; top: 100%; left: 0; right: 0;
      flex-direction: column; gap: 1rem; padding: 1rem 1.5rem;
      background: var(--bg); border-bottom: 1px solid var(--border); display: none;
    }
    .nav-links.open { display: flex; }
    .menu-btn { display: flex; }
  }

  /* Terminal window */
  .win {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
  }
  .win-bar {
    display: flex; align-items: center; gap: 0.5rem;
    padding: 0.55rem 0.9rem;
    background: var(--bar);
    border-bottom: 1px solid var(--border);
    font-family: "JetBrains Mono", ui-monospace, Consolas, monospace;
    font-size: 0.75rem; color: var(--muted);
  }
  .dots { display: flex; gap: 6px; }
  .dots i { width: 10px; height: 10px; border-radius: 50%; background: var(--border); display: block; }
  .dots i:nth-child(1) { background: #ff5f57; }
  .dots i:nth-child(2) { background: #febc2e; }
  .dots i:nth-child(3) { background: #28c840; }
  .win-body { padding: 1.4rem 1.5rem; }

  /* Hero */
  .hero { padding: 3.5rem 0 3rem; }
  .term {
    font-family: "JetBrains Mono", ui-monospace, Consolas, monospace;
    font-size: 0.95rem; line-height: 1.75;
  }
  .term .line { margin: 0; }
  .term .ps { color: var(--green); }
  .term .path { color: var(--accent); }
  .term .out { color: var(--text); margin: 0 0 1rem; }
  .term .out strong { font-size: clamp(1.4rem, 4vw, 1.9rem); font-weight: 700; display: block; line-height: 1.3; }
  .term .out .dim { color: var(--muted); }
  .term .out .hl { color: var(--amber); }
  .term .out a { color: var(--accent); text-decoration: none; margin-right: 1rem; }
  .term .out a:hover { text-decoration: underline; }
  .cursor {
    display: inline-block; width: 0.6em; height: 1.1em; margin-left: 2px;
    background: var(--accent); vertical-align: text-bottom;
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }
  .hidden-out { visibility: hidden; }

  /* Section titles */
  section.block { padding: 3rem 0; }
  .section-head h2 {
    margin: 0 0 1.4rem; font-size: 1.35rem; font-weight: 700;
    font-family: "JetBrains Mono", ui-monospace, Consolas, monospace;
  }
  .section-head .p { color: var(--green); }

  /* Compétences */
  .code {
    margin: 0; overflow-x: auto;
    font-family: "JetBrains Mono", ui-monospace, Consolas, monospace;
    font-size: 0.9rem; line-height: 1.8; color: var(--muted);
  }
  .code .k { color: var(--accent); }
  .code .s { color: var(--amber); }

  /* Projets */
  .filters {
    display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.4rem;
    font-family: "JetBrains Mono", ui-monospace, Consolas, monospace;
  }
  .filter-btn {
    border: 1px solid var(--border); background: var(--panel); color: var(--muted);
    padding: 0.4rem 0.9rem; border-radius: 6px;
    font: inherit; font-size: 0.82rem; cursor: pointer;
  }
  .filter-btn:hover { color: var(--text); }
  .filter-btn.active { border-color: var(--accent); color: var(--accent); }

  .project-grid { display: grid; gap: 1.1rem; }
  .project .win-body { padding: 1.3rem 1.5rem; }
  .project h3 { margin: 0 0 0.5rem; font-size: 1.1rem; }
  .project p { margin: 0 0 0.9rem; color: var(--muted); font-size: 0.95rem; }
  .project .stack {
    display: flex; flex-wrap: wrap; gap: 0.4rem;
    font-family: "JetBrains Mono", ui-monospace, Consolas, monospace;
  }
  .project .stack span {
    font-size: 0.76rem; color: var(--accent);
    border: 1px solid var(--border); padding: 0.15rem 0.55rem; border-radius: 4px;
  }
  .empty-state {
    color: var(--muted); font-size: 0.88rem;
    font-family: "JetBrains Mono", ui-monospace, Consolas, monospace;
  }

  /* Veille */
  .veille-entry {
    display: flex; gap: 1.1rem; padding: 0.9rem 0;
    border-bottom: 1px dashed var(--border);
  }
  .veille-entry:last-child { border-bottom: none; }
  .veille-date {
    flex-shrink: 0; width: 70px; padding-top: 0.15rem;
    font-family: "JetBrains Mono", ui-monospace, Consolas, monospace;
    font-size: 0.82rem; color: var(--green);
  }
  .veille-entry h4 { margin: 0 0 0.25rem; font-size: 1rem; }
  .veille-entry p { margin: 0; color: var(--muted); font-size: 0.92rem; }

  /* Contact */
  .contact-links {
    display: flex; flex-direction: column; gap: 0.6rem;
    font-family: "JetBrains Mono", ui-monospace, Consolas, monospace; font-size: 0.92rem;
  }
  .contact-links div { color: var(--muted); }
  .contact-links .key { color: var(--green); margin-right: 0.6rem; }
  .contact-links a { color: var(--accent); text-decoration: none; }
  .contact-links a:hover { text-decoration: underline; }

  footer {
    border-top: 1px solid var(--border); padding: 2rem 0; text-align: center;
    color: var(--muted); font-size: 0.82rem;
    font-family: "JetBrains Mono", ui-monospace, Consolas, monospace;
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .cursor { animation: none; }
  }
</style>
</head>
