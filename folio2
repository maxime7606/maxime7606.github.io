<style>
  /* ===== 1. COULEURS : thème clair, puis thème sombre ===== */
  :root {
    --bg: #f3f5f8;  --panel: #ffffff;  --bar: #e4e9f0;  --border: #d3dae5;
    --text: #17212f;  --muted: #55637a;
    --accent: #0a6c8a;  --green: #1a7f37;  --amber: #9a5b00;
    --grid: rgba(10, 108, 138, 0.06);
    --mono: "JetBrains Mono", ui-monospace, Consolas, monospace;
    color-scheme: light;
  }
  [data-theme="dark"] {
    --bg: #0a111d;  --panel: #101a2a;  --bar: #16233a;  --border: #213250;
    --text: #d8e3f2;  --muted: #8a9bb5;
    --accent: #5ad1e6;  --green: #7ee787;  --amber: #f2b84b;
    --grid: rgba(90, 209, 230, 0.05);
    color-scheme: dark;
  }

  /* ===== 2. BASE ===== */
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    font-family: "Inter", system-ui, sans-serif;
    line-height: 1.6;
    color: var(--text);
    /* fond quadrillé */
    background-color: var(--bg);
    background-image:
      linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 32px 32px;
  }
  main { max-width: 920px; margin: 0 auto; padding: 0 1.5rem; }
  section { padding: 3rem 0; }
  section, article { scroll-margin-top: 84px; }  /* pour ne pas passer sous le menu */
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  /* Tout ce qui est écrit en police "terminal" */
  header, footer, button, h2, pre, .win-bar, .term, .refs, .tag, .stack, .links,
  .date, small, .note, .empty, .contact { font-family: var(--mono); }

  h2 { margin: 0 0 1.4rem; font-size: 1.35rem; }
  h2::before { content: "~/"; color: var(--green); }
  h3 { margin: 0 0 0.7rem; font-size: 1.05rem; }
  .empty, .note { margin: 0; color: var(--muted); font-size: 0.85rem; }

  /* ===== 3. MENU DU HAUT ===== */
  header { position: sticky; top: 0; z-index: 20; background: var(--bg); border-bottom: 1px solid var(--border); }
  nav { display: flex; align-items: center; justify-content: space-between; max-width: 920px; margin: 0 auto; padding: 0.9rem 1.5rem; }
  .logo { font-weight: 700; font-size: 0.92rem; color: var(--green); }
  .menu { display: flex; gap: 1.5rem; list-style: none; margin: 0; padding: 0; }
  .menu a { font-size: 0.85rem; color: var(--muted); }
  .nav-btns { display: flex; gap: 0.75rem; }
  .nav-btns button { width: 34px; height: 34px; border: 1px solid var(--border); border-radius: 6px; background: var(--panel); color: var(--text); cursor: pointer; }
  #themeBtn::before { content: "\2600\FE0E"; }                      /* soleil */
  [data-theme="dark"] #themeBtn::before { content: "\263E"; }       /* lune */
  #menuBtn { display: none; }

  /* Sur téléphone : le menu se déplie avec le bouton ☰ */
  @media (max-width: 700px) {
    #menuBtn { display: block; }
    .menu { display: none; position: absolute; top: 100%; left: 0; right: 0; flex-direction: column; gap: 1rem; padding: 1rem 1.5rem; background: var(--bg); border-bottom: 1px solid var(--border); }
    .menu.open { display: flex; }
  }

  /* ===== 4. FENÊTRE (le cadre utilisé partout) ===== */
  .win { margin-bottom: 1.1rem; background: var(--panel); border: 1px solid var(--border); border-radius: 10px; overflow: hidden; }
  .win-bar { display: flex; align-items: center; padding: 0.55rem 0.9rem; background: var(--bar); border-bottom: 1px solid var(--border); font-size: 0.75rem; color: var(--muted); }
  /* les 3 pastilles rouge / orange / verte, dessinées en CSS */
  .win-bar::before { content: ""; width: 10px; height: 10px; margin-right: 44px; border-radius: 50%; background: #ff5f57; box-shadow: 16px 0 #febc2e, 32px 0 #28c840; }
  .win-body { padding: 1.3rem 1.5rem; }

  /* ===== 5. TERMINAL D'ACCUEIL ===== */
  .term { font-size: 0.95rem; line-height: 1.75; }
  .term p { margin: 0; }
  .term .cmd::before { content: "maxime@portfolio:~$ "; color: var(--green); }
  .term .out { margin-bottom: 1rem; }
  .term .out strong { display: block; font-size: clamp(1.4rem, 4vw, 1.9rem); line-height: 1.3; }
  .term .out a { margin-right: 1rem; }
  .dim { color: var(--muted); }
  .hl { color: var(--amber); }
  /* curseur qui clignote sur la dernière ligne */
  .term p:last-child::after { content: ""; display: inline-block; width: 0.6em; height: 1.1em; background: var(--accent); vertical-align: text-bottom; animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }

  /* ===== 6. COMPÉTENCES ===== */
  .comp { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.2rem 1rem; margin: 0; padding: 0.55rem 0; border-bottom: 1px dashed var(--border); font-size: 0.94rem; }
  .comp:last-child { border-bottom: none; }
  .comp span:first-child::before { content: "[ok] "; margin-right: 0.3rem; color: var(--green); font-family: var(--mono); }
  .refs { display: flex; flex-wrap: wrap; gap: 0.2rem 0.9rem; font-size: 0.78rem; }
  pre { margin: 0; overflow-x: auto; font-size: 0.9rem; line-height: 1.8; color: var(--amber); }
  pre b { color: var(--accent); font-weight: 400; }

  /* ===== 7. PROJETS ===== */
  .filters { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.4rem; }
  .filters button { padding: 0.4rem 0.9rem; border: 1px solid var(--border); border-radius: 6px; background: var(--panel); color: var(--muted); font-size: 0.82rem; cursor: pointer; }
  .filters button.active { border-color: var(--accent); color: var(--accent); }
  article p, article li { color: var(--muted); font-size: 0.95rem; }
  article p { margin: 0 0 0.9rem; }
  article ul { margin: 0 0 1rem; padding-left: 1.2rem; }
  article li::marker { color: var(--green); }
  article b { color: var(--text); }
  article .tag { margin-bottom: 0.5rem; color: var(--amber); font-size: 0.74rem; }
  .stack { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .stack span { padding: 0.15rem 0.55rem; border: 1px solid var(--border); border-radius: 4px; color: var(--accent); font-size: 0.76rem; }
  article .links { margin: 1rem 0 0; font-size: 0.84rem; }

  /* ===== 8. VEILLE ===== */
  .news { display: flex; gap: 1.1rem; padding: 0.9rem 0; border-bottom: 1px dashed var(--border); }
  .news:last-child { border-bottom: none; }
  .news .date { flex-shrink: 0; width: 60px; color: var(--green); font-size: 0.82rem; }
  .news a { color: var(--text); font-weight: 600; }
  .news a:hover { color: var(--accent); }
  .news small { display: block; color: var(--muted); font-size: 0.78rem; }
  .note { margin-top: 1rem; }

  /* ===== 9. PARCOURS ===== */
  .etape { display: flex; gap: 1.1rem; padding: 0.9rem 0; border-bottom: 1px dashed var(--border); }
  .etape:last-child { border-bottom: none; }
  .etape .date { flex-shrink: 0; width: 6.5rem; padding-top: 0.15rem; color: var(--green); font-size: 0.82rem; }
  .etape h3 { margin: 0 0 0.2rem; font-size: 1rem; }
  .etape p { margin: 0; color: var(--muted); font-size: 0.92rem; }
  .etape .en-cours { color: var(--amber); }

  /* ===== 10. CONTACT ===== */
  .contact div { display: flex; align-items: center; gap: 0.7rem; padding: 0.35rem 0; color: var(--muted); font-size: 0.92rem; }
  .contact svg { flex-shrink: 0; width: 20px; height: 20px; fill: none; stroke: var(--accent); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .contact .key { width: 4.6rem; flex-shrink: 0; color: var(--green); }
  .contact a { min-width: 0; overflow-wrap: anywhere; }

  footer { padding: 2rem 0; border-top: 1px solid var(--border); text-align: center; color: var(--muted); font-size: 0.82rem; }

  /* Pas d'animation pour les personnes qui les ont désactivées */
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .term p:last-child::after { animation: none; }
  }
</style>
