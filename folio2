<script>
  // ---------- 1. Bouton thème clair / sombre ----------
  document.getElementById("themeBtn").addEventListener("click", function () {
    const page = document.documentElement;
    page.dataset.theme = page.dataset.theme === "dark" ? "light" : "dark";
    localStorage.setItem("theme", page.dataset.theme);   // on retient le choix
  });

  // ---------- 2. Menu sur téléphone ----------
  const menu = document.getElementById("menu");
  document.getElementById("menuBtn").addEventListener("click", function () {
    menu.classList.toggle("open");
  });
  menu.addEventListener("click", function () {   // on referme après un clic sur un lien
    menu.classList.remove("open");
  });

  // ---------- 3. Boutons de filtre (projets et veille) ----------
  // Met en couleur le bouton cliqué et enlève la couleur des autres
  function activer(bouton) {
    bouton.parentElement.querySelectorAll("button").forEach(function (b) {
      b.classList.remove("active");
    });
    bouton.classList.add("active");
  }

  // Filtre des projets : on cache ceux qui ne sont pas de la catégorie choisie
  document.querySelectorAll("#filtresProjets button").forEach(function (bouton) {
    bouton.addEventListener("click", function () {
      activer(bouton);
      const filtre = bouton.dataset.filter;
      let visibles = 0;
      document.querySelectorAll("article").forEach(function (projet) {
        const montrer = filtre === "tous" || projet.dataset.category === filtre;
        projet.hidden = !montrer;
        if (montrer) visibles++;
      });
      document.getElementById("aucunProjet").hidden = visibles > 0;
    });
  });

  // ---------- 4. Effet "frappe au clavier" dans le terminal d'accueil ----------
  const sorties = document.querySelectorAll("#term .out");
  const animer = !window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (animer) {
    // Au départ : on vide chaque commande (en gardant son texte) et on cache son résultat
    const textes = [];
    sorties.forEach(function (sortie) {
      const commande = sortie.previousElementSibling;
      textes.push(commande.textContent);
      commande.textContent = "";
      sortie.style.visibility = "hidden";
    });

    // Écrit la commande numéro n lettre par lettre, puis passe à la suivante
    function taper(n) {
      if (n >= sorties.length) return;
      const commande = sorties[n].previousElementSibling;
      let lettres = 0;
      const minuteur = setInterval(function () {
        lettres++;
        commande.textContent = textes[n].slice(0, lettres);
        if (lettres >= textes[n].length) {
          clearInterval(minuteur);
          sorties[n].style.visibility = "visible";
          setTimeout(function () { taper(n + 1); }, 350);
        }
      }, 55);
    }
    setTimeout(function () { taper(0); }, 400);
  }

  // ---------- 5. Veille : affiche les actus du fichier veille.json ----------
  // (veille.json est mis à jour chaque jour par GitHub Actions avec veille.py)
  const liste = document.getElementById("listeVeille");
  let veille = null;        // le contenu de veille.json
  let categorie = "tous";   // l'onglet choisi

  // Crée une balise avec une classe et un texte
  function creer(balise, classe, texte) {
    const element = document.createElement(balise);
    element.className = classe;
    element.textContent = texte;
    return element;
  }

  function afficherVeille() {
    liste.textContent = "";

    // On rassemble les actus de la catégorie choisie
    const actus = [];
    for (const nom in veille.categories) {
      if (categorie === "tous" || categorie === nom) {
        veille.categories[nom].forEach(function (actu) {
          actu.categorie = nom;
          actus.push(actu);
        });
      }
    }
    if (actus.length === 0) {
      liste.append(creer("p", "empty", "> Aucune actu pour le moment."));
      return;
    }

    // Les plus récentes en premier
    actus.sort(function (a, b) { return (b.date || "").localeCompare(a.date || ""); });

    // Une ligne par actu : la date, le titre (lien) et la source
    actus.forEach(function (actu) {
      let jour = "--/--";
      if (actu.date) {
        jour = new Date(actu.date).toLocaleDateString("fr-FR", { day: "2-digit", month: "2-digit" });
      }
      const lien = creer("a", "", actu.titre);
      if (/^https?:\/\//.test(actu.lien)) {   // on n'accepte que les vrais liens web
        lien.href = actu.lien;
        lien.target = "_blank";
        lien.rel = "noopener";
      }
      const texte = creer("div", "", "");
      texte.append(lien, creer("small", "", actu.source + " #" + actu.categorie));
      const ligne = creer("div", "news", "");
      ligne.append(creer("span", "date", jour), texte);
      liste.append(ligne);
    });
  }

  document.querySelectorAll("#filtresVeille button").forEach(function (bouton) {
    bouton.addEventListener("click", function () {
      activer(bouton);
      categorie = bouton.dataset.cat;
      if (veille) afficherVeille();
    });
  });

  // Chargement du fichier
  fetch("veille.json")
    .then(function (reponse) { return reponse.json(); })
    .then(function (contenu) {
      veille = contenu;
      afficherVeille();
      document.getElementById("noteVeille").textContent =
        "Dernière mise à jour : " + new Date(veille.maj).toLocaleString("fr-FR");
    })
    .catch(function () {
      liste.textContent = "";
      liste.append(creer("p", "empty", "> Impossible de charger veille.json."));
    });
</script>

</body>
</html>
